# E2E 测试专用配置。复制为 .env.e2e 后填写；不提交、不随线上发布。

TUITUI_APP_ID=
TUITUI_APP_SECRET=

# 单聊目标账号及测试群群主
TUITUI_E2E_ACCOUNT=zhangsan

# 测试图片 URL
TUITUI_E2E_IMAGE_URL=https://www.baidu.com/img/flexible/logo/pc/result.png

# 预期被服务端拒绝的测试图片 URL
TUITUI_E2E_INVALID_IMAGE_URL=https://beijing2.xstore.qihoo.net/1.png

# 测试文件 URL
TUITUI_E2E_FILE_URL=https://www.baidu.com/robots.txt

# 预期被服务端 SSRF 防护拒绝的内网文件 URL
TUITUI_E2E_INVALID_FILE_URL=http://192.168.1.1/test.txt
